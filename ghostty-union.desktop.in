[Desktop Entry]
Version=1.0
Type=Application
Name=Ghostty Union
GenericName=Terminal Emulator
Comment=Union-styled KDE terminal powered by libghostty-vt with mounted system monitor bar
TryExec=@GHOSTTY_UNION_EXEC@
Exec=@GHOSTTY_UNION_EXEC@
Icon=@GHOSTTY_UNION_ICON@
Categories=System;TerminalEmulator;Qt;KDE;
Keywords=terminal;tty;pty;shell;ghostty;union;
StartupNotify=true
StartupWMClass=ghostty-union
Terminal=false
X-TerminalArgDir=--working-directory=
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Icon=@GHOSTTY_UNION_ICON@
Exec=@GHOSTTY_UNION_EXEC@
